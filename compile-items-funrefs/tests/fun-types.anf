priv fun fun-app(f : fun (I32) -> Bool, x : I32) : Bool := f(x);

priv fun id-i32-bool(f : fun (I32) -> Bool) : fun (I32) -> Bool := f;

priv fun ignore-param(_ : fun (I32, Bool) -> I32) : I32 := 43;

priv fun is-one(x : I32) : Bool := #i32-eq(x, 1);

priv fun is-zero(x : I32) : Bool := #i32-eq(x, 0);

priv fun local-binding(f : fun (I32) -> I32, x : I32) : I32 :=
  let g : fun (I32) -> I32 := f;
  g(x);

pub val test-hof-1 : Bool := fun-app(is-zero, 3);

pub val test-hof-2 : Bool := fun-app(is-zero, 45);

pub val test-hof-3 : Bool := fun-app(is-one, 1);
