priv fun add(x : I32, y : I32) : I32 := #i32-add(x, y);

priv fun apply2(f : fun (I32, I32) -> I32, x : I32, y : I32) : I32 :=
  f(x, y);

priv fun compare(f : fun (I32, I32) -> Bool, x : I32, y : I32) : Bool :=
  f(x, y);

priv fun equal(x : I32, y : I32) : Bool := #i32-eq(x, y);

priv fun forty-two() : I32 := 42;

pub val test-add : I32 := apply2(add, 1, 2);

pub val test-equal : Bool := compare(equal, 1, 2);

pub val test-thunk : I32 := thunk(forty-two);

priv fun thunk(f : fun () -> I32) : I32 := f();
